{
	"plugins": ["prettier-plugin-astro"],
	"useTabs": true,
	"tabWidth": 2,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": true,
	"printWidth": 80,
	"trailingComma": "none",
	"singleAttributePerLine": true,
	"overrides": [
		{
			"files": "*.astro",
			"options": { "parser": "astro" }
		}
	]
}
