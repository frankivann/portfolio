---
// Mock-up: a quiet sidebar (after recent.design). Sticky in the first column
// of the page frame, right next to the sheets; no panel of its own — the
// sheets stay the only "objects".
// The portfolio index. Entries without an `id` have no sheet yet: they fill the
// index as plain, non-clickable text.
const portfolio: { label: string; id?: string; tag?: string }[] = [
	{ id: 'portada', label: 'Portada' },
	{ id: 'multibrand', label: 'Multibrand' },
	{ id: 'pasarela', label: 'Pasarela de pagos' },
	{ label: 'Counter web', tag: 'pronto' },
	{ label: 'Cute dark' }
]

const resources = ['Tecnologías', 'Skills', 'Otros']

// Profile cards, rotated one at a time with a linear loader (after recent.design).
const profiles = [
	{
		network: 'GitHub',
		handle: '@frankivann',
		url: 'https://github.com/frankivann',
		description: 'Código, experimentos y el repositorio de este portfolio.',
		tile: '#171717',
		icon: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12'
	},
	{
		network: 'LinkedIn',
		handle: 'in/frankalvarado',
		url: 'https://www.linkedin.com/in/frankalvarado/',
		description: 'Trayectoria, experiencia y contacto profesional.',
		tile: '#0A66C2',
		icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z'
	}
]
---

<aside
	id='aside'
	class='sticky top-0 z-40 hidden h-svh flex-col py-4 text-[13px] leading-[1.4] xl:flex'
>
	<!-- Top: mark + edition -->
	<div class='flex items-center justify-between'>
		<a
			href='#portada'
			data-goto='portada'
			aria-label='Portada'
			class='group grid size-7 place-items-center'
		>
			<span
				class='size-7 rounded-full bg-primary transition-transform duration-500 ease-(--ease-out-expo) group-hover:scale-90'
			></span>
		</a>
	</div>

	<!-- Navigation -->
	<nav
		aria-label='Secciones'
		class='mt-11 space-y-[22px]'
	>
		<div>
			<h2 class='text-black/30'>Portfolio</h2>
			<ul>
				{
					portfolio.map((entry) => {
						const tag = entry.tag && (
							<span class='relative font-kalam text-[13px] leading-none text-primary'>
								{entry.tag}
								<svg
									class='absolute -bottom-1.5 left-0 h-1.5 w-full overflow-visible'
									viewBox='0 0 40 6'
									preserveAspectRatio='none'
									fill='none'
									stroke='currentColor'
									stroke-width='1.3'
									stroke-linecap='round'
									aria-hidden='true'
								>
									<path d='M1 4 C 8 1, 14 6, 21 3 S 33 2, 39 3' />
								</svg>
							</span>
						)

						return (
							<li>
								{entry.id ? (
									<a
										href={`#${entry.id}`}
										data-goto={entry.id}
										data-nav={entry.id}
										class='aside-link group inline-flex h-6 items-center gap-2 pr-3.5 text-black/50 transition-colors duration-200 hover:text-neutral-900'
									>
										{entry.label}
										<span class='aside-dot size-2 scale-0 rounded-full bg-neutral-900 transition-transform duration-300 ease-(--ease-out-expo)' />
										{tag}
									</a>
								) : (
									<span class='inline-flex h-6 cursor-default items-center gap-2 pr-3.5 text-black/30'>
										{entry.label}
										{tag}
									</span>
								)}
							</li>
						)
					})
				}
			</ul>
		</div>

		<div>
			<h2 class='text-black/30'>Recursos</h2>
			<ul>
				{
					resources.map((resource) => (
						<li>
							<a
								href='#'
								class='inline-flex h-6 items-center pr-3.5 text-black/50 transition-colors duration-200 hover:text-neutral-900'
							>
								{resource}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</nav>

	<!-- Bottom: rotating profile cards, their loader, and the imprint -->
	<div class='aside-profiles mt-auto'>
		<div
			class='grid'
			role='region'
			aria-label='Perfiles'
		>
			{
				profiles.map((profile, i) => (
					<a
						href={profile.url}
						target='_blank'
						rel='noopener noreferrer'
						data-profile
						inert={i !== 0 ? true : undefined}
						class:list={[
							'aside-card group -mx-2 block rounded-lg p-2 [grid-area:1/1] hover:bg-white',
							i === 0 && 'is-active'
						]}
					>
						<div class='flex items-center gap-2.5'>
							<span
								class='grid size-9 shrink-0 place-items-center rounded-lg text-white'
								style={`background-color: ${profile.tile}`}
							>
								<svg
									viewBox='0 0 24 24'
									class='size-[18px]'
									fill='currentColor'
									aria-hidden='true'
								>
									<path d={profile.icon} />
								</svg>
							</span>
							<div class='min-w-0'>
								<p class='truncate text-neutral-900'>Franklin Alvarado</p>
								<p class='truncate text-black/50'>
									{profile.network} · {profile.handle}
								</p>
							</div>
							<svg
								viewBox='0 0 24 24'
								class='ml-auto size-3.5 shrink-0 -translate-x-1 text-black/30 opacity-0 transition-[opacity,translate] duration-300 ease-(--ease-out-expo) group-hover:translate-x-0 group-hover:opacity-100'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								aria-hidden='true'
							>
								<path d='M7 7h10v10' />
								<path d='M7 17 17 7' />
							</svg>
						</div>
						<p class='mt-3 text-black/50'>{profile.description}</p>
					</a>
				))
			}
		</div>

		<div
			class='mt-4 h-px overflow-hidden bg-black/[0.09]'
			aria-hidden='true'
		>
			<span class='aside-progress block h-full origin-left bg-neutral-900'
			></span>
		</div>

		<p class='mt-4 flex items-center gap-1 text-black/30'>
			<svg
				viewBox='0 0 24 24'
				class='size-3.5'
				fill='none'
				stroke='currentColor'
				stroke-width='1.75'
				stroke-linecap='round'
				stroke-linejoin='round'
				aria-hidden='true'
			>
				<circle
					cx='12'
					cy='12'
					r='10'
				></circle>
				<path d='M14.83 14.83a4 4 0 1 1 0-5.66'></path>
			</svg>
			<span class='sr-only'>Copyright</span>
			{new Date().getFullYear()}
		</p>
	</div>
</aside>

<style>
	.aside-link[aria-current] {
		color: var(--color-neutral-900);
	}

	.aside-link[aria-current] .aside-dot {
		scale: 1;
	}

	/* Rotating cards: all share one grid cell; the active one is sharp and
	   opaque, the rest wait blurred, faded and a few pixels low. */
	.aside-card {
		opacity: 0;
		filter: blur(6px);
		transform: translateY(6px);
		pointer-events: none;
		transition:
			opacity 600ms var(--ease-out-expo),
			filter 600ms var(--ease-out-expo),
			transform 600ms var(--ease-out-expo),
			background-color 300ms;
	}

	.aside-card.is-active {
		opacity: 1;
		filter: none;
		transform: none;
		pointer-events: auto;
	}

	/* The loader is a pure CSS animation; JS only reacts when it ends. Hovering
	   the cards pauses it, so a card never slides away under the cursor. */
	.aside-progress {
		transform: scaleX(0);
	}

	.aside-progress.is-running {
		animation: aside-progress 12s linear forwards;
	}

	.aside-profiles:hover .aside-progress,
	.aside-profiles:focus-within .aside-progress {
		animation-play-state: paused;
	}

	@keyframes aside-progress {
		to {
			transform: scaleX(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.aside-card {
			filter: none;
			transform: none;
			transition: opacity 200ms;
		}
	}
</style>

<script>
	import { getArrivals, getSheets } from '../scripts/stack'

	// Mark the project currently on screen.
	const sheets = getSheets()
	const links = Array.from(document.querySelectorAll<HTMLElement>('[data-nav]'))
	let arrivals = getArrivals(sheets)
	let frame: number | null = null

	let currentId: string | undefined

	// Cheap on purpose: per frame it only reads scrollY (no layout) and touches
	// the DOM only when the current sheet actually changes.
	function update() {
		frame = null
		// A sheet counts as current once it covers half the screen.
		const y = scrollY + innerHeight / 2
		let current = 0
		arrivals.forEach((arrival, i) => {
			if (y >= arrival) current = i
		})

		const id = sheets[current]?.id
		if (id === currentId) return
		currentId = id

		for (const link of links) {
			if (link.dataset.nav === id) link.setAttribute('aria-current', 'page')
			else link.removeAttribute('aria-current')
		}
	}

	function remeasure() {
		arrivals = getArrivals(sheets)
		update()
	}

	addEventListener('scroll', () => (frame ??= requestAnimationFrame(update)), {
		passive: true
	})
	addEventListener('resize', remeasure)
	// Arrivals only change when a sheet changes size (fonts, images).
	const observer = new ResizeObserver(remeasure)
	sheets.forEach((sheet) => observer.observe(sheet))

	update()

	// Profile cards: advance each time the loader fills.
	const cards = Array.from(
		document.querySelectorAll<HTMLElement>('[data-profile]')
	)
	const progress = document.querySelector<HTMLElement>('.aside-progress')
	const rotate =
		cards.length > 1 &&
		progress &&
		!matchMedia('(prefers-reduced-motion: reduce)').matches

	if (rotate) {
		let active = 0

		const show = (index: number) => {
			cards.forEach((card, i) => {
				card.classList.toggle('is-active', i === index)
				// Hidden cards must not be reachable by keyboard or screen readers.
				card.toggleAttribute('inert', i !== index)
			})
		}

		const restart = () => {
			progress.classList.remove('is-running')
			void progress.offsetWidth // restart the CSS animation from 0
			progress.classList.add('is-running')
		}

		progress.addEventListener('animationend', () => {
			active = (active + 1) % cards.length
			show(active)
			restart()
		})

		restart()
	}
</script>
