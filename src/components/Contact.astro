---
interface Props {
	/** Lay the entries out on one line instead of stacked. */
	inline?: boolean
}

const { inline = false } = Astro.props
const email = 'franklinalvarado0921@gmail.com'
---

<ul
	class:list={[
		inline ? 'flex flex-wrap items-baseline gap-x-8 gap-y-2' : 'space-y-2'
	]}
>
	<li class='flex flex-wrap items-baseline gap-x-4 gap-y-1'>
		<a
			href={`mailto:${email}`}
			class='ink-link text-neutral-900'
		>
			{email}
		</a>
		<button
			type='button'
			data-copy={email}
			class='label cursor-pointer transition-colors hover:text-primary'
		>
			Copiar
		</button>
	</li>
	<li>
		<a
			href='https://github.com/frankivann'
			target='_blank'
			rel='noopener noreferrer'
			class='ink-link text-neutral-900'
		>
			github.com/frankivann
		</a>
	</li>
</ul>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
		let timeout: number | undefined

		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy!)
			} catch {
				return
			}

			button.textContent = 'Copiado ✓'
			button.classList.add('text-primary')
			clearTimeout(timeout)
			timeout = window.setTimeout(() => {
				button.textContent = 'Copiar'
				button.classList.remove('text-primary')
			}, 1800)
		})
	})
</script>
