---
import { Sun, Moon, Menu, X } from '@lucide/astro'

const links = [
	{ href: '#inicio', label: 'Inicio' },
	{ href: '#proyectos', label: 'Proyectos' },
	{ href: '#contacto', label: 'Contacto' }
]

const themeIconClasses =
	'absolute h-[18px] w-[18px] transition-all duration-300 ease-out'
---

<header
	class='sticky top-0 z-50 border-b border-neutral-200/80 bg-neutral-100/70 backdrop-blur-sm backdrop-saturate-150 dark:border-neutral-800/80 dark:bg-neutral-900/70'
>
	<div
		class='mx-auto flex h-16 max-w-6xl items-center justify-between px-6 md:grid md:grid-cols-[1fr_auto_1fr]'
	>
		<a
			href='#inicio'
			class='justify-self-start'
			aria-label='Inicio'
		>
			<span class='block h-8 w-8 rounded-full bg-primary'></span>
		</a>

		<nav
			class='relative hidden items-center gap-1 justify-self-center md:flex'
			aria-label='Principal'
		>
			<span
				class='nav-indicator pointer-events-none absolute top-0 left-0 h-full rounded-full bg-neutral-900/5 opacity-0 transition-[transform,width,opacity,background-color] duration-300 ease-out dark:bg-white/10'
			></span>
			{
				links.map((link) => (
					<a
						href={link.href}
						class='nav-link relative z-10 rounded-full px-4 py-2 text-sm font-normal text-neutral-500 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white'
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class='flex items-center gap-2 justify-self-end'>
			<a
				href='https://www.linkedin.com/in/frankalvarado'
				target='_blank'
				rel='noopener noreferrer'
				class='hidden h-9 w-9 items-center justify-center rounded-full border border-neutral-200 text-neutral-900 hover:border-neutral-400 md:inline-flex dark:border-neutral-800 dark:text-white dark:hover:border-neutral-600'
				aria-label='LinkedIn'
			>
				<svg
					class='h-[18px] w-[18px]'
					viewBox='0 0 24 24'
					fill='none'
					stroke='currentColor'
					stroke-width='1.75'
					stroke-linecap='round'
					stroke-linejoin='round'
				>
					<path
						d='M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z'
					></path>
					<rect
						width='4'
						height='12'
						x='2'
						y='9'
					></rect>
					<circle
						cx='4'
						cy='4'
						r='2'
					></circle>
				</svg>
			</a>

			<button
				type='button'
				class='theme-toggle relative hidden h-9 w-9 items-center justify-center rounded-full border border-neutral-200 text-neutral-900 hover:border-neutral-400 md:inline-flex dark:border-neutral-800 dark:text-white dark:hover:border-neutral-600'
				aria-label='Cambiar tema'
			>
				<Sun
					class={`${themeIconClasses} scale-100 rotate-0 opacity-100 dark:scale-50 dark:-rotate-90 dark:opacity-0`}
					stroke-width={1.75}
				/>
				<Moon
					class={`${themeIconClasses} scale-50 rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100`}
					stroke-width={1.75}
				/>
			</button>

			<button
				type='button'
				class='menu-toggle group relative inline-flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 text-neutral-900 hover:border-neutral-400 md:hidden dark:border-neutral-800 dark:text-white dark:hover:border-neutral-600'
				aria-label='Abrir menú'
				aria-expanded='false'
				aria-controls='mobile-menu'
				data-state='closed'
			>
				<Menu
					class='absolute h-[18px] w-[18px] scale-100 rotate-0 opacity-100 transition-all duration-300 ease-out group-data-[state=open]:scale-50 group-data-[state=open]:rotate-90 group-data-[state=open]:opacity-0'
					stroke-width={1.75}
				/>
				<X
					class='absolute h-[18px] w-[18px] scale-50 -rotate-90 opacity-0 transition-all duration-300 ease-out group-data-[state=open]:scale-100 group-data-[state=open]:rotate-0 group-data-[state=open]:opacity-100'
					stroke-width={1.75}
				/>
			</button>
		</div>
	</div>

	<div
		id='mobile-menu'
		class='mobile-panel grid grid-rows-[0fr] border-neutral-200/80 transition-[grid-template-rows,border-color] duration-[300ms,200ms] ease-out data-[state=open]:grid-rows-[1fr] data-[state=open]:border-t md:hidden dark:border-neutral-800/80'
		data-state='closed'
	>
		<div class='overflow-hidden'>
			<nav
				class='flex flex-col gap-1 px-6 pt-2 pb-3'
				aria-label='Principal (móvil)'
			>
				{
					links.map((link) => (
						<a
							href={link.href}
							class='mobile-link rounded-lg px-3 py-2.5 text-sm font-normal text-neutral-500 hover:bg-neutral-900/5 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-white/5 dark:hover:text-white'
						>
							{link.label}
						</a>
					))
				}
			</nav>
			<div
				class='flex items-center justify-between border-t border-neutral-200/80 px-6 py-3 dark:border-neutral-800/80'
			>
				<span class='text-sm font-medium text-neutral-500 dark:text-neutral-400'
					>Más</span
				>
				<div class='flex items-center gap-2'>
					<a
						href='https://www.linkedin.com/in/frankalvarado'
						target='_blank'
						rel='noopener noreferrer'
						class='inline-flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 text-neutral-900 hover:border-neutral-400 dark:border-neutral-800 dark:text-white dark:hover:border-neutral-600'
						aria-label='LinkedIn'
					>
						<svg
							class='h-[18px] w-[18px]'
							viewBox='0 0 24 24'
							fill='none'
							stroke='currentColor'
							stroke-width='1.75'
							stroke-linecap='round'
							stroke-linejoin='round'
						>
							<path
								d='M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z'
							></path>
							<rect
								width='4'
								height='12'
								x='2'
								y='9'
							></rect>
							<circle
								cx='4'
								cy='4'
								r='2'
							></circle>
						</svg>
					</a>

					<button
						type='button'
						class='theme-toggle relative inline-flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 text-neutral-900 hover:border-neutral-400 dark:border-neutral-800 dark:text-white dark:hover:border-neutral-600'
						aria-label='Cambiar tema'
					>
						<Sun
							class={`${themeIconClasses} scale-100 rotate-0 opacity-100 dark:scale-50 dark:-rotate-90 dark:opacity-0`}
							stroke-width={1.75}
						/>
						<Moon
							class={`${themeIconClasses} scale-50 rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100`}
							stroke-width={1.75}
						/>
					</button>
				</div>
			</div>
		</div>
	</div>
</header>

<script>
	const nav =
		document.querySelector<HTMLElement>('.nav-indicator')?.parentElement ?? null
	const indicator = document.querySelector<HTMLElement>('.nav-indicator')
	const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link')

	function moveIndicatorTo(el: HTMLElement) {
		if (!indicator || !nav) return
		const navRect = nav.getBoundingClientRect()
		const linkRect = el.getBoundingClientRect()
		indicator.style.width = `${linkRect.width}px`
		indicator.style.transform = `translateX(${linkRect.left - navRect.left}px)`
		indicator.style.opacity = '1'
	}

	navLinks.forEach((link) => {
		link.addEventListener('mouseenter', () => moveIndicatorTo(link))
	})

	nav?.addEventListener('mouseleave', () => {
		if (indicator) indicator.style.opacity = '0'
	})

	document
		.querySelectorAll<HTMLButtonElement>('.theme-toggle')
		.forEach((button) => {
			button.addEventListener('click', () => {
				const root = document.documentElement
				const next =
					root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
				root.setAttribute('data-theme', next)
				localStorage.setItem('theme', next)
			})
		})

	const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle')
	const mobileMenu = document.querySelector<HTMLElement>('#mobile-menu')

	function setMenuOpen(open: boolean) {
		const state = open ? 'open' : 'closed'
		menuToggle?.setAttribute('data-state', state)
		menuToggle?.setAttribute('aria-expanded', String(open))
		mobileMenu?.setAttribute('data-state', state)
	}

	menuToggle?.addEventListener('click', () => {
		setMenuOpen(menuToggle.getAttribute('data-state') !== 'open')
	})

	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => setMenuOpen(false))
	})

	matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
		if (e.matches) setMenuOpen(false)
	})
</script>
