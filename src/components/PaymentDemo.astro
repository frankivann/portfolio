---
// The card step of the real checkout, rebuilt in HTML and played like a short
// video: the form fills itself in a loop and the card mirrors it live. Text,
// not pixels — sharp at any screen density, a few KB instead of megabytes.
//
// Colours and sizes are measured from the product; the type is the
// portfolio's own (Geist, Geist Mono), so no extra fonts load. Every
// size is in em, and the em follows the plate's width, so the whole page scales
// like a picture while staying text.
import Figure from './Figure.astro'
import Row from './Row.astro'

interface Props {
	n: number
	caption?: string
	/** Matches a `data-ref` in the text: hovering either lights up the other. */
	ref?: string
}

const {
	n,
	caption = 'Formulario de reservas multibrand',
	ref
} = Astro.props
---

<Row wide>
	<!-- The "video" controls: pause/play and the loop's progress. -->
	<div
		slot='meta'
		class='flex items-center gap-2.5'
	>
		<!-- 28px circle, 44px hit area (the ::before); icon at 4.7:1 on white. -->
		<button
			type='button'
			data-pd-toggle
			class='relative grid size-7 shrink-0 place-items-center rounded-full border border-neutral-300 text-neutral-500 transition-colors before:absolute before:-inset-2 hover:border-neutral-400 hover:text-neutral-900'
			aria-label='Pausar animación'
		>
			<svg
				data-pd-icon-pause
				viewBox='0 0 10 10'
				class='size-2.5'
				fill='currentColor'
				aria-hidden='true'
			>
				<rect
					x='1.5'
					y='1'
					width='2.2'
					height='8'
				></rect>
				<rect
					x='6.3'
					y='1'
					width='2.2'
					height='8'
				></rect>
			</svg>
			<svg
				data-pd-icon-play
				viewBox='0 0 10 10'
				class='hidden size-2.5'
				fill='currentColor'
				aria-hidden='true'
			>
				<path d='M2.5 1 9 5 2.5 9z'></path>
			</svg>
		</button>
		<div class='h-px w-full max-w-24 bg-neutral-200'>
			<div
				data-pd-progress
				class='h-full origin-left bg-primary'
				style='transform: scaleX(0)'
			>
			</div>
		</div>
	</div>

	<Figure
		n={n}
		caption={caption}
		ref={ref}
		ratio='auto'
	>
		<div
			class='pd'
			data-pd
			role='img'
			aria-label='Formulario de pago con tarjeta: al escribir el número, el titular y la fecha, la tarjeta se actualiza en vivo.'
		>
			<div
				class='pd-stage'
				aria-hidden='true'
			>
				<div class='pd-panel'>
					<header class='pd-head'>
						<h3 class='pd-title'>Datos de la tarjeta</h3>
						<div class='pd-brands'>
							<svg
								viewBox='0 0 24 24'
								class='pd-shield'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
							>
								<path
									d='M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z'
								></path>
								<path d='m9 12 2 2 4-4'></path>
							</svg>
							<span>Pagos con</span>
							<span class='pd-badge pd-visa-badge'>VISA</span>
							<span class='pd-badge'>
								<svg
									viewBox='0 0 32 20'
									class='pd-mc'
								>
									<circle
										cx='11'
										cy='10'
										r='7.5'
										fill='#eb001b'
									></circle>
									<circle
										cx='21'
										cy='10'
										r='7.5'
										fill='#f79e1b'
									></circle>
									<path
										d='M16 4.4a7.5 7.5 0 0 1 0 11.2 7.5 7.5 0 0 1 0-11.2z'
										fill='#ff5f00'
									></path>
								</svg>
							</span>
						</div>
					</header>

					<div class='pd-body'>
						<div class='pd-form'>
							<div class='pd-field'>
								<div class='pd-label'>
									Número de tarjeta<span class='pd-star'>*</span>
								</div>
								<div
									class='pd-input'
									data-pd-field='num'
								>
									<span data-pd-value></span>
								</div>
							</div>

							<div class='pd-field'>
								<div class='pd-label'>
									Nombre del titular<span class='pd-star'>*</span>
								</div>
								<div
									class='pd-input'
									data-pd-field='name'
								>
									<span data-pd-value></span>
								</div>
							</div>

							<div class='pd-row'>
								<div class='pd-field'>
									<div class='pd-label'>
										Mes<span class='pd-star'>*</span>
									</div>
									<div
										class='pd-input'
										data-pd-field='mm'
									>
										<span data-pd-value></span>
									</div>
								</div>
								<div class='pd-field'>
									<div class='pd-label'>
										Año<span class='pd-star'>*</span>
									</div>
									<div
										class='pd-input'
										data-pd-field='yy'
									>
										<span data-pd-value></span>
									</div>
								</div>
								<div class='pd-field'>
									<div class='pd-label'>
										CVC<span class='pd-star'>*</span>
									</div>
									<div
										class='pd-input pd-cvc'
										data-pd-field='cvc'
									>
										<span data-pd-value></span>
									</div>
								</div>
							</div>

							<div class='pd-terms'>
								<span
									class='pd-check'
									data-pd-check
								>
									<svg
										viewBox='0 0 24 24'
										fill='none'
										stroke='currentColor'
										stroke-width='3.5'
										stroke-linecap='round'
										stroke-linejoin='round'
									>
										<path d='M20 6 9 17l-5-5'></path>
									</svg>
								</span>
								<span>
									Acepto los <span class='pd-link'
										>términos y condiciones de Wompi</span
									><span class='pd-star'>*</span>
								</span>
							</div>
						</div>

						<div class='pd-side'>
							<div class='pd-card'>
								<div class='pd-card-top'>
									<svg
										viewBox='0 0 42 31'
										class='pd-chip'
									>
										<rect
											width='42'
											height='31'
											rx='5'
											fill='#d9bf7a'
										></rect>
										<path
											d='M0 10.5h13M0 20.5h13M29 10.5h13M29 20.5h13M13 0v31M29 0v31M13 15.5h16'
											stroke='#b39a55'
											stroke-width='1.2'
											fill='none'
										></path>
									</svg>
									<svg
										viewBox='0 0 24 24'
										class='pd-nfc'
										fill='none'
										stroke='currentColor'
										stroke-width='1.8'
										stroke-linecap='round'
									>
										<path d='M6 8.32a7.43 7.43 0 0 1 0 7.36'></path>
										<path d='M9.46 6.21a11.76 11.76 0 0 1 0 11.58'></path>
										<path d='M12.91 4.1a15.91 15.91 0 0 1 .01 15.8'></path>
									</svg>
									<span
										class='pd-card-visa'
										data-pd-visa
										>VISA</span
									>
								</div>
								<div
									class='pd-card-num'
									data-pd-card='num'
								>
								</div>
								<div class='pd-card-foot'>
									<div>
										<div class='pd-card-label'>Nombre del titular</div>
										<div
											class='pd-card-name'
											data-pd-card='name'
										>
										</div>
									</div>
									<div class='pd-card-exp'>
										<div class='pd-card-label'>Vence</div>
										<div
											class='pd-card-date'
											data-pd-card='exp'
										>
										</div>
									</div>
								</div>
							</div>

							<p class='pd-note'>
								<svg
									viewBox='0 0 24 24'
									fill='none'
									stroke='currentColor'
									stroke-width='2'
									stroke-linecap='round'
									stroke-linejoin='round'
								>
									<rect
										width='18'
										height='11'
										x='3'
										y='11'
										rx='2'
										ry='2'
									></rect>
									<path d='M7 11V7a5 5 0 0 1 10 0v4'></path>
								</svg>
								<span>
									Pago seguro con Wompi. Los datos de su tarjeta se envían
									cifrados directamente a Wompi; nosotros no los guardamos.
								</span>
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</Figure>
</Row>

<style>
	/* A picture made of text: it can't be selected. */
	.pd {
		container-type: inline-size;
		background: #f1f5f9;
		user-select: none;
		-webkit-user-select: none;
	}

	/* ------------------------------------------------------------ Scale
	   The plate is the container; 1em = 1/58 of its width on the wide layout
	   (the product's panel, a little tighter). Stacked, the picture is cropped
	   to the card and the number field, so 1em can be 1/24: the card fills the
	   width and the type stays legible on a phone. */
	.pd-stage {
		--ink: #0f172a;
		--text: #334155;
		--muted: #64748b;
		--line: #cad5e2;
		--hair: #e2e8f0;
		--green: #2a885c;
		--card: #232877;

		font-family: var(--font-geist);
		font-size: calc(100cqw / 24);
		color: var(--text);
		padding: 0.6em;
		line-height: 1.4;
		-webkit-font-smoothing: antialiased;
	}

	@container (min-width: 600px) {
		.pd-stage {
			font-size: calc(100cqw / 58);
		}
	}

	/* ------------------------------------------------------------ Panel */
	.pd-panel {
		background: white;
		border: 1px solid var(--hair);
		border-radius: 0.6em;
		padding: 1.6em 1.2em 1.6em;
	}

	/* Stacked crop: the card, its note and the number field — the part that
	   moves and tells the story. The rest of the form returns when wide. */
	@container (max-width: 599.98px) {
		.pd-form > :not(:first-child) {
			display: none;
		}
	}

	@container (min-width: 600px) {
		.pd-panel {
			padding: 2.6em 2.6em 3em;
		}
	}

	.pd-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}

	.pd-title {
		margin: 0;
		font-size: 1.5em;
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--ink);
	}

	.pd-brands {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.8em;
		color: var(--muted);
	}

	.pd-shield {
		width: 1.15em;
		height: 1.15em;
		margin-right: -0.1em;
	}

	.pd-badge {
		display: grid;
		place-items: center;
		width: 3.4em;
		height: 2.1em;
		margin-left: 0.25em;
		border: 1px solid var(--hair);
		border-radius: 0.3em;
		background: white;
	}

	.pd-badge + .pd-badge {
		margin-left: 0;
	}

	.pd-visa-badge {
		color: #1a1f71;
		font-weight: 600;
		font-style: italic;
		font-size: 0.95em;
		letter-spacing: -0.02em;
		width: 3.6em;
		height: 2.2em;
	}

	.pd-mc {
		width: 1.9em;
	}

	/* ------------------------------------------------------------ Form */
	.pd-body {
		display: grid;
		gap: 2.5em;
		margin-top: 2.2em;
	}

	@container (min-width: 600px) {
		.pd-body {
			grid-template-columns: 27.4em 1fr;
			gap: 3em;
			margin-top: 2.4em;
		}
	}

	.pd-form {
		display: grid;
		gap: 1.6em;
	}

	.pd-label {
		font-size: 0.875em;
		font-weight: 500;
		line-height: 1.2;
		margin-bottom: 0.55em;
	}

	.pd-star {
		color: #ef4444;
		margin-left: 0.1em;
	}

	.pd-input {
		position: relative;
		display: flex;
		align-items: center;
		height: 2.4em;
		padding: 0 0.75em;
		border: 1px solid var(--line);
		border-radius: 0.4em;
		color: #1e293b;
		white-space: pre;
		transition:
			border-color 150ms,
			box-shadow 150ms;
	}

	.pd-input.is-focused {
		border-color: var(--green);
		box-shadow: 0 0 0 0.19em color-mix(in oklab, var(--green) 18%, transparent);
	}

	/* The caret: a 1px bar after the value, blinking like a real one. */
	.pd-input.is-focused::after {
		content: '';
		width: 1px;
		height: 1.1em;
		margin-left: 1px;
		background: #1e293b;
		animation: pd-caret 1s steps(1) infinite;
	}

	@keyframes pd-caret {
		50% {
			opacity: 0;
		}
	}

	.pd-cvc [data-pd-value] {
		letter-spacing: 0.05em;
	}

	.pd-row {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.05em;
	}

	.pd-terms {
		display: flex;
		align-items: center;
		gap: 0.6em;
		font-size: 0.875em;
		margin-top: 0.4em;
	}

	.pd-check {
		display: grid;
		place-items: center;
		width: 1.1em;
		height: 1.1em;
		flex-shrink: 0;
		border: 1px solid var(--line);
		border-radius: 0.2em;
		color: white;
		transition:
			background-color 150ms,
			border-color 150ms;
	}

	.pd-check svg {
		width: 0.75em;
		opacity: 0;
		transition: opacity 150ms;
	}

	.pd-check.is-checked {
		background: var(--green);
		border-color: var(--green);
	}

	.pd-check.is-checked svg {
		opacity: 1;
	}

	.pd-link {
		color: var(--green);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	/* Values fade out together before the loop starts over. */
	[data-pd-value],
	[data-pd-card],
	.pd-check {
		transition: opacity 350ms;
	}

	.pd.is-clearing [data-pd-value],
	.pd.is-clearing [data-pd-card],
	.pd.is-clearing .pd-check {
		opacity: 0;
	}

	/* ------------------------------------------------------------ Card */
	/* Stacked, the card leads — as on the product's phone layout. */
	.pd-side {
		display: grid;
		justify-items: center;
		align-content: start;
		order: -1;
	}

	@container (min-width: 600px) {
		.pd-side {
			padding-top: 0.3em;
			order: 0;
		}
	}

	.pd-card {
		position: relative;
		overflow: hidden;
		width: 20em;
		height: 12.6em;
		padding: 1.4em 1.4em 1.3em;
		border-radius: 0.9em;
		background: var(--card);
		color: white;
		display: flex;
		flex-direction: column;
		box-shadow: 0 0.6em 1.5em -0.8em rgb(15 23 42 / 0.45);
	}

	/* The two soft discs of the original card. */
	.pd-card::before,
	.pd-card::after {
		content: '';
		position: absolute;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.045);
		pointer-events: none;
	}

	.pd-card::before {
		width: 21em;
		height: 21em;
		top: -10.5em;
		right: -10.5em;
	}

	.pd-card::after {
		width: 14em;
		height: 14em;
		bottom: -9.5em;
		left: -4.5em;
	}

	.pd-card-top {
		display: flex;
		align-items: center;
		gap: 0.9em;
	}

	.pd-chip {
		width: 2.6em;
	}

	.pd-nfc {
		width: 1.15em;
		opacity: 0.75;
	}

	.pd-card-visa {
		margin-left: auto;
		font-size: 1.55em;
		font-weight: 600;
		font-style: italic;
		letter-spacing: -0.02em;
		line-height: 1;
		opacity: 0;
		transform: translateY(0.15em);
		transition:
			opacity 250ms,
			transform 250ms;
	}

	.pd-card-visa.is-on {
		opacity: 1;
		transform: none;
	}

	.pd-card-num {
		margin-top: auto;
		font-family: var(--font-geist-mono);
		font-size: 1.15em;
		font-weight: 400; /* Geist Mono loads at 400 only: no faux bold */
		display: flex;
		gap: 0.55em;
		line-height: 1;
	}

	/* Built by the script, so :global reaches past Astro's scoping. Each slot
	   is a fixed, clipped box: characters slide through it, never beside it. */
	.pd-card-num :global(.pd-group) {
		display: flex;
	}

	.pd-card-num :global(.pd-slot) {
		position: relative;
		width: 0.62em;
		height: 1.1em;
		overflow: hidden;
		text-align: center;
	}

	.pd-card-num :global(.pd-ch) {
		display: block;
		line-height: 1.1em;
	}

	.pd-card-num :global(.pd-ch.is-dot) {
		opacity: 0.4;
	}

	.pd-card-num :global(.pd-ch.is-leaving) {
		position: absolute;
		inset: 0;
	}

	.pd-card-foot {
		display: flex;
		justify-content: space-between;
		align-items: end;
		margin-top: 1.3em;
	}

	.pd-card-label {
		font-size: 0.56em;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.55);
	}

	.pd-card-name {
		margin-top: 0.35em;
		font-size: 0.9em;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		white-space: pre;
	}

	.pd-card-exp {
		text-align: right;
	}

	.pd-card-date {
		margin-top: 0.35em;
		font-family: var(--font-geist-mono);
		font-size: 0.85em;
		font-weight: 400;
	}

	.pd-note {
		display: flex;
		gap: 0.6em;
		width: calc(20em / 0.75); /* the card's width, in this smaller type */
		margin: 1em 0 0;
		font-size: 0.75em;
		line-height: 1.5;
		color: var(--muted);
	}

	.pd-note svg {
		width: 1.2em;
		height: 1.2em;
		flex-shrink: 0;
	}
</style>

<script>
	// The loop, as a pure function of time: stateAt(t) says what every field
	// shows at t ms, so pausing, looping and reduced motion are all the same
	// render with a different clock.
	const NUM = '4242424242424242'
	const NAME = 'Franklin Alvarado'
	const MM = '12'
	const YY = '29'

	// [start ms, ms per character]
	const T = {
		num: [700, 65],
		name: [2500, 70],
		mm: [4250, 120],
		yy: [4800, 120],
		cvc: [5350, 120],
		check: 6250,
		clear: 8700,
		loop: 9300
	} as const

	// Each field holds focus from a little before its first key to the next one.
	const FOCUS: [string, number, number][] = [
		['num', 450, 2300],
		['name', 2300, 4050],
		['mm', 4050, 4600],
		['yy', 4600, 5150],
		['cvc', 5150, 5950]
	]

	const typed = (
		text: string,
		[start, step]: readonly [number, number],
		t: number
	) =>
		t < start
			? ''
			: text.slice(0, Math.min(text.length, Math.floor((t - start) / step) + 1))

	const stateAt = (t: number) => {
		const num = typed(NUM, T.num, t)
		const mm = typed(MM, T.mm, t)
		const yy = typed(YY, T.yy, t)
		return {
			num,
			name: typed(NAME, T.name, t),
			mm,
			yy,
			cvc: '•'.repeat(typed('123', T.cvc, t).length),
			checked: t >= T.check,
			clearing: t >= T.clear,
			focus: FOCUS.find(([, a, b]) => t >= a && t < b)?.[0] ?? '',
			card: {
				num: (num + '•'.repeat(16 - num.length)).replace(/(.{4})(?=.)/g, '$1 '),
				name: NAME.slice(0, typed(NAME, T.name, t).length) || 'Nombre Apellido',
				exp: `${mm.padEnd(2, '•')}/${yy.padEnd(2, '•')}`,
				// Fades with the rest while the loop clears.
				visa: num.startsWith('4') && t < T.clear
			}
		}
	}

	document.querySelectorAll<HTMLElement>('[data-pd]').forEach((root) => {
		const row = root.closest('.doc-row')
		const toggle = row?.querySelector<HTMLButtonElement>('[data-pd-toggle]')
		const progress = row?.querySelector<HTMLElement>('[data-pd-progress]')
		const fields = new Map(
			[...root.querySelectorAll<HTMLElement>('[data-pd-field]')].map((el) => [
				el.dataset.pdField!,
				el
			])
		)
		const cards = new Map(
			[...root.querySelectorAll<HTMLElement>('[data-pd-card]')].map((el) => [
				el.dataset.pdCard!,
				el
			])
		)
		const check = root.querySelector<HTMLElement>('[data-pd-check]')!
		const visa = root.querySelector<HTMLElement>('[data-pd-visa]')!

		const set = (el: HTMLElement | undefined | null, text: string) => {
			if (el && el.textContent !== text) el.textContent = text
		}

		// The card number, as on the product: 4 groups of 4 fixed, clipped slots.
		// When a slot changes, the old character slides up and out while the new
		// one rises in from below — a dot turns into a digit like an odometer.
		// Read live, not once: the preference can change with the page open.
		const reduce = matchMedia('(prefers-reduced-motion: reduce)')
		const numEl = cards.get('num')!
		const glyph = (ch: string) => {
			const span = document.createElement('span')
			span.className = ch === '•' ? 'pd-ch is-dot' : 'pd-ch'
			span.textContent = ch
			return span
		}
		const slots: HTMLElement[] = []
		numEl.replaceChildren(
			...[0, 1, 2, 3].map(() => {
				const group = document.createElement('span')
				group.className = 'pd-group'
				for (let i = 0; i < 4; i++) {
					const slot = document.createElement('span')
					slot.className = 'pd-slot'
					slot.append(glyph('•'))
					slots.push(slot)
					group.append(slot)
				}
				return group
			})
		)

		const setNum = (text: string) => {
			const chars = text.replace(/ /g, '')
			slots.forEach((slot, i) => {
				const ch = chars[i]
				const current = slot.lastElementChild as HTMLElement
				if (current.textContent === ch) return
				const next = glyph(ch)
				slot.append(next)
				// Back to a dot only happens when the loop restarts, under the
				// fade: swap at once, or the digits would show again on the way out.
				if (reduce.matches || ch === '•') return current.remove()
				// Leaving: up and out, quicker, out of the flow.
				current.classList.add('is-leaving')
				current
					.animate(
						[{ transform: 'none' }, { transform: 'translateY(-100%)', opacity: 0 }],
						{ duration: 150, easing: 'cubic-bezier(0.4, 0, 1, 1)', fill: 'forwards' }
					)
					.finished.then(() => current.remove())
				// Entering: up from below the slot.
				next.animate(
					[{ transform: 'translateY(100%)', opacity: 0 }, { transform: 'none' }],
					{ duration: 200, easing: 'cubic-bezier(0, 0, 0.2, 1)' }
				)
			})
		}

		const render = (t: number) => {
			const s = stateAt(t)
			for (const [key, el] of fields) {
				set(el.querySelector('[data-pd-value]'), s[key as 'num'])
				el.classList.toggle('is-focused', s.focus === key)
			}
			setNum(s.card.num)
			set(cards.get('name'), s.card.name)
			set(cards.get('exp'), s.card.exp)
			visa.classList.toggle('is-on', s.card.visa)
			check.classList.toggle('is-checked', s.checked)
			root.classList.toggle('is-clearing', s.clearing)
			if (progress) progress.style.transform = `scaleX(${t / T.loop})`
		}

		let t = 0
		let last = 0
		let paused = false
		let visible = false
		let frame = 0

		const tick = (now: number) => {
			t = (t + Math.min(now - last, 100)) % T.loop
			last = now
			render(t)
			frame = requestAnimationFrame(tick)
		}
		const sync = () => {
			cancelAnimationFrame(frame)
			// Reduced motion: the finished form, still. No controls to offer.
			toggle?.parentElement?.classList.toggle('hidden', reduce.matches)
			if (reduce.matches) {
				render(T.check + 1)
				for (const el of fields.values()) el.classList.remove('is-focused')
				return
			}
			render(t)
			if (visible && !paused) {
				last = performance.now()
				frame = requestAnimationFrame(tick)
			}
		}

		sync()
		reduce.addEventListener('change', sync)

		// Plays only while on screen, like a muted autoplay video.
		new IntersectionObserver(
			([entry]) => {
				visible = entry.isIntersecting
				sync()
			},
			{ threshold: 0.35 }
		).observe(root)

		toggle?.addEventListener('click', () => {
			paused = !paused
			toggle.setAttribute(
				'aria-label',
				paused ? 'Reproducir animación' : 'Pausar animación'
			)
			toggle
				.querySelector('[data-pd-icon-pause]')
				?.classList.toggle('hidden', paused)
			toggle
				.querySelector('[data-pd-icon-play]')
				?.classList.toggle('hidden', !paused)
			sync()
		})
	})
</script>
