---
import Annotation from './Annotation.astro'
import TechStack from './TechStack.astro'

const brands = [
	{ name: 'National', url: 'https://nationalpanama.com' },
	{ name: 'Alamo', url: 'https://alamopanama.com' },
	{ name: 'Enterprise', url: 'https://enterprisepanama.com' }
]

// Flecha de "abre fuera" (lucide arrow-up-right), inline como en TechStack.
const arrowUpRight = `<svg class="size-3.5 shrink-0 transition-transform duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] sm:size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>`

// Se arma como string porque el formateador mete un salto de línea entre `</a>`
// y la puntuación, y ese salto se renderiza como un espacio: "National ↗ ,".
const brandsHtml = brands
	.map(
		(brand, index) =>
			`<a href="${brand.url}" target="_blank" rel="noopener noreferrer" aria-label="${brand.name} (se abre en una pestaña nueva)" class="brand-link group inline-flex items-center gap-0.5 font-medium decoration-primary underline-offset-4 hover:underline">${brand.name}${arrowUpRight}</a>${index < brands.length - 1 ? ', ' : '.'}`
	)
	.join('')

