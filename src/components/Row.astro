---
// One line of the document grid: reading column · notes margin. The rows sit
// in a body narrower than the letterhead, centred, so the sheet has the same
// air on both sides.
interface Props {
	/** Let the content run across the reading column and the notes margin. */
	wide?: boolean
	class?: string
}

const { wide = false, class: className } = Astro.props
const hasNote = Astro.slots.has('note')
const hasMeta = Astro.slots.has('meta')
---

<div class:list={['doc-row', className]}>
	<div class:list={['min-w-0', wide && 'lg:col-span-2']}>
		<!-- Controls for what follows (a figure's play/pause, a carousel's
		     arrows): a slim bar just above it. -->
		{
			hasMeta && (
				<div class='mb-3'>
					<slot name='meta' />
				</div>
			)
		}
		<slot />
	</div>

	{
		!wide && (
			<div class='relative hidden lg:block'>
				{hasNote && <slot name='note' />}
			</div>
		)
	}
</div>
