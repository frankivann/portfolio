---
// MOCK-UP — the cover breaks the document grid on purpose: centred, no margin
// labels. Content sheets read left-aligned; the cover reads like a title page.
import Contact from '../Contact.astro'
---

<!-- Title block: sits in the upper part of the sheet, so it — tools included — lands in the
     optical centre of the first screen while the sheet keeps a portrait shape. -->
<div class='flex flex-col items-center pt-[4vh] text-center lg:pt-[9vh]'>
	<p class='label text-[12px] text-neutral-500'>
		Tech Lead · Full Stack Web Developer
	</p>

	<h1
		class='mt-6 text-5xl leading-[0.95] font-semibold tracking-[-0.04em] text-neutral-900 sm:text-7xl lg:text-[5.25rem]'
	>
		Franklin Alvarado
	</h1>

	<p
		class='mt-8 max-w-[46ch] text-lg leading-relaxed text-balance text-neutral-500 sm:text-xl'
	>
		<span class='relative whitespace-nowrap font-medium text-neutral-800'>
			+5 años de experiencia
		</span> ofreciendo soluciones de alto rendimiento. <span
			class='relative whitespace-nowrap font-medium text-neutral-800'
		>
			Enfocado en el producto y el negocio.</span
		>
	</p>

	<div
		class='mt-10 flex justify-center [&_li]:justify-center [&_ul]:justify-center'
	>
		<Contact inline />
	</div>
</div>
