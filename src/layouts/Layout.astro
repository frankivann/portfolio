---
import Header from '../components/Header.astro'
import '../styles/global.css'

interface Props {
	title?: string
}

const { title = 'Franklin Alvarado — Full Stack Web Developer' } = Astro.props
---

<!doctype html>
<html lang='es'>
	<head>
		<meta charset='utf-8' />
		<meta
			name='viewport'
			content='width=device-width'
		/>
		<link
			rel='icon'
			type='image/svg+xml'
			href='/favicon.svg'
		/>
		<link
			rel='icon'
			href='/favicon.ico'
		/>
		<meta
			name='generator'
			content={Astro.generator}
		/>
		<title>{title}</title>
		<!-- Trial fonts via Fontsource CDN (jsDelivr) — not installed as a dependency yet.
		     Geist = headings, Manrope = body/descriptions. -->
		<link
			rel='stylesheet'
			href='https://cdn.jsdelivr.net/npm/@fontsource/geist@5/500.css'
		/>
		<link
			rel='stylesheet'
			href='https://cdn.jsdelivr.net/npm/@fontsource/geist@5/600.css'
		/>
		<link
			rel='stylesheet'
			href='https://cdn.jsdelivr.net/npm/@fontsource/geist@5/700.css'
		/>
		<link
			rel='stylesheet'
			href='https://cdn.jsdelivr.net/npm/@fontsource/manrope@5/400.css'
		/>
		<link
			rel='stylesheet'
			href='https://cdn.jsdelivr.net/npm/@fontsource/manrope@5/500.css'
		/>
		<script is:inline>
			const stored = localStorage.getItem('theme')
			const theme =
				stored ??
				(matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
			document.documentElement.setAttribute('data-theme', theme)
		</script>
	</head>
	<body>
		<Header />

		<slot />
	</body>
</html>
