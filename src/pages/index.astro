---
import Layout from '../layouts/Layout.astro'
import Hero from '../components/Hero.astro'
---

<Layout>
	<main>
		<Hero />

		<section
			id='proyectos'
			class='flex min-h-screen items-center justify-center border-b border-neutral-200/80 text-sm text-neutral-500 dark:border-neutral-800/80 dark:text-neutral-400'
		>
			<p>Desarrollos — pendiente</p>
		</section>

		<section
			id='contacto'
			class='flex min-h-screen items-center justify-center text-sm text-neutral-500 dark:text-neutral-400'
		>
			<p>Contacto — pendiente</p>
		</section>
	</main>
</Layout>
